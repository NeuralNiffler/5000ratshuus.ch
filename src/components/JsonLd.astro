---
/**
 * Rendert ein JSON-LD-Objekt. Die Objekte selbst entstehen in
 * src/lib/jsonld.ts, damit Prüfung 7 (src/lib/checks.ts) dieselben prüft.
 */
import type { JsonLdObjekt } from "../lib/jsonld";

interface Props {
  daten: JsonLdObjekt;
}

// "<" escapen, damit ein "</script>" in einem Titel das Script nicht beendet.
const json = JSON.stringify(Astro.props.daten).replace(/</g, "\\u003c");
---

<script type="application/ld+json" set:html={json} is:inline />
