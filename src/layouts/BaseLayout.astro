---
import "../styles/global.css";
import JsonLd from "../components/JsonLd.astro";
import { siteConfig } from "../site.config";
import {
  absoluteUrl,
  brotkrumenJsonLd,
  STANDARD_BILD_PFAD,
  type Brotkrume,
  type JsonLdObjekt,
} from "../lib/jsonld";
import { OG_BREITE, OG_HOEHE } from "../lib/og-bild";

interface Props {
  title: string;
  description: string;
  keywords?: string[];
  ogDescription?: string;
  ogType?: "website" | "article";
  /** Veröffentlichungsdatum für og:article, nur bei ogType "article". */
  publishedTime?: string;
  /** Letzte Korrektur für og:article, nur bei ogType "article". */
  modifiedTime?: string;
  /** Rubrik für og:article, z. B. die Kategorie der Ausgabe. */
  section?: string;
  /** Pfad des Vorschaubilds, ohne Angabe das Standardbild. */
  image?: string;
  imageAlt?: string;
  /** Seite nicht in Suchmaschinen aufnehmen (z. B. 404, Danke-Seite). */
  noindex?: boolean;
  /** Brotkrumen-Navigation, sichtbar und als BreadcrumbList im JSON-LD. */
  breadcrumbs?: Brotkrume[];
  /** Weitere JSON-LD-Objekte der Seite, siehe src/lib/jsonld.ts. */
  jsonLd?: JsonLdObjekt[];
}

const {
  title,
  description,
  keywords = [],
  ogDescription,
  ogType = "website",
  publishedTime,
  modifiedTime,
  section,
  image = STANDARD_BILD_PFAD,
  imageAlt = title,
  noindex = false,
  breadcrumbs = [],
  jsonLd = [],
} = Astro.props;

const canonicalUrl = absoluteUrl(Astro.url.pathname);
const imageUrl = absoluteUrl(image);
const fullTitle = title.includes(siteConfig.name) ? title : `${title} · ${siteConfig.name}`;
const [disclaimerVor, disclaimerNach] = siteConfig.disclaimer.split("Kontaktformular");
const alleJsonLd = breadcrumbs.length > 0 ? [...jsonLd, brotkrumenJsonLd(breadcrumbs)] : jsonLd;
---

<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.name} href="/rss.xml" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_BREITE)} />
    <meta property="og:image:height" content={String(OG_HOEHE)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {ogType === "article" && section && <meta property="article:section" content={section} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {alleJsonLd.map((daten) => <JsonLd daten={daten} />)}
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">{siteConfig.name}</a>
        <nav>
          <a href="/">Startseite</a>
          <a href="/archiv/">Archiv</a>
          <a href="/ueber/">Über</a>
          <a href="/kontakt/">Kontakt</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      {breadcrumbs.length > 1 && (
        <nav class="brotkrumen" aria-label="Brotkrumen">
          <ol>
            {breadcrumbs.map((k, i) =>
              i === breadcrumbs.length - 1 ? (
                <li aria-current="page">{k.name}</li>
              ) : (
                <li>
                  <a href={k.pfad}>{k.name}</a>
                </li>
              ),
            )}
          </ol>
        </nav>
      )}
      <slot />
    </main>
    <div class="wrap">
      <footer class="site-footer">
        <p class="note">
          {disclaimerVor}<a href={siteConfig.contactPath}>Kontaktformular</a>{disclaimerNach}
        </p>
        <p>
          <a href="/impressum/">Impressum</a> · <a href="/datenschutz/">Datenschutz</a> ·
          <a href="/disclaimer/">Disclaimer</a> · <a href="/rss/">RSS-Feed</a>
        </p>
      </footer>
    </div>
  </body>
</html>
