---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GeschaeftListItem from "../../components/GeschaeftListItem.astro";
import {
  getAlleGeschaefte,
  getDistinctTags,
  getDistinctArten,
  getDistinctJahre,
  GESCHAEFT_ART_LABEL,
} from "../../lib/index-db";
import { slugify } from "../../lib/format";
import { sammlungJsonLd } from "../../lib/jsonld";
import { archivBeschreibung } from "../../lib/format";

const eintraege = getAlleGeschaefte();
const tags = getDistinctTags();
const arten = getDistinctArten();
const jahre = getDistinctJahre();
const titel = "Archiv der Aarauer Kommunalpolitik";
const beschreibung = archivBeschreibung(eintraege, "chronologisch, nach Thema, Art des Geschäfts und Datum");
---

<BaseLayout
  title={titel}
  description={beschreibung}
  breadcrumbs={[
    { name: "Startseite", pfad: "/" },
    { name: "Archiv", pfad: "/archiv/" },
  ]}
  jsonLd={[sammlungJsonLd(titel, beschreibung, "/archiv/")]}
>
  <h1>Archiv</h1>

  <p class="page-content">
    Alle bisherigen Geschäfte, chronologisch. Zusätzlich nach Thema oder Art des Geschäfts gefiltert:
  </p>

  <div class="filter-box">
    <p class="eyebrow">Thema</p>
    <nav class="archiv-nav" aria-label="Nach Thema">
      {tags.map((tag) => (
        <a href={`/archiv/thema/${slugify(tag)}/`}>{tag}</a>
      ))}
    </nav>
    <p class="eyebrow">Art des Geschäfts</p>
    <nav class="archiv-nav" aria-label="Nach Art des Geschäfts">
      {arten.map((art) => (
        <a href={`/archiv/art/${art}/`}>{GESCHAEFT_ART_LABEL[art]}</a>
      ))}
    </nav>
    <p class="eyebrow">Datum</p>
    <nav class="archiv-nav" aria-label="Nach Datum">
      {jahre.map((jahr) => (
        <a href={`/archiv/datum/${jahr}/`}>{jahr}</a>
      ))}
    </nav>
  </div>

  <ul class="artikel-liste">
    {eintraege.map((eintrag) => <GeschaeftListItem eintrag={eintrag} />)}
  </ul>
</BaseLayout>
