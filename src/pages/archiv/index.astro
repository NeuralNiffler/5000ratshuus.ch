---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllAusgaben, getArtikelUrl } from "../../lib/content";
import { getDistinctTags, getDistinctArten, GESCHAEFT_ART_LABEL } from "../../lib/index-db";
import { formatDatumLesbar, slugify } from "../../lib/format";
import { siteConfig } from "../../site.config";

const ausgaben = getAllAusgaben();
const tags = getDistinctTags();
const arten = getDistinctArten();
---

<BaseLayout
  title="Archiv"
  description={`Alle Artikel von ${siteConfig.name}, chronologisch, sowie nach Thema und Art des Geschäfts.`}
>
  <h1>Archiv</h1>

  <p class="page-content">
    Alle bisher publizierten Artikel, chronologisch. Zusätzlich nach Thema oder Art des Geschäfts gefiltert:
  </p>

  <nav class="archiv-nav" aria-label="Nach Thema">
    {tags.map((tag) => (
      <a href={`/archiv/thema/${slugify(tag)}/`}>{tag}</a>
    ))}
  </nav>
  <nav class="archiv-nav" aria-label="Nach Art des Geschäfts">
    {arten.map((art) => (
      <a href={`/archiv/art/${art}/`}>{GESCHAEFT_ART_LABEL[art]}</a>
    ))}
  </nav>

  <ul class="artikel-liste">
    {
      ausgaben.map((ausgabe) => (
        <li>
          <p class="eyebrow">
            {formatDatumLesbar(ausgabe.frontmatter.datePublished)} · {ausgabe.frontmatter.kategorie}
          </p>
          <h2>
            <a href={getArtikelUrl(ausgabe)}>{ausgabe.frontmatter.headline}</a>
          </h2>
        </li>
      ))
    }
  </ul>
</BaseLayout>
