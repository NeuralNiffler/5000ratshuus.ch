---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GeschaeftListItem from "../../components/GeschaeftListItem.astro";
import { getAlleGeschaefte, getDistinctTags, getDistinctArten, GESCHAEFT_ART_LABEL } from "../../lib/index-db";
import { slugify } from "../../lib/format";
import { siteConfig } from "../../site.config";

const eintraege = getAlleGeschaefte();
const tags = getDistinctTags();
const arten = getDistinctArten();
---

<BaseLayout
  title="Archiv"
  description={`Alle Geschäfte von ${siteConfig.name}, chronologisch, sowie nach Thema und Art des Geschäfts.`}
>
  <h1>Archiv</h1>

  <p class="page-content">
    Alle bisherigen Geschäfte, chronologisch. Zusätzlich nach Thema oder Art des Geschäfts gefiltert:
  </p>

  <p class="eyebrow">Thema</p>
  <nav class="archiv-nav" aria-label="Nach Thema">
    {tags.map((tag) => (
      <a href={`/archiv/thema/${slugify(tag)}/`}>{tag}</a>
    ))}
  </nav>
  <p class="eyebrow">Art des Geschäfts</p>
  <nav class="archiv-nav" aria-label="Nach Art des Geschäfts">
    {arten.map((art) => (
      <a href={`/archiv/art/${art}/`}>{GESCHAEFT_ART_LABEL[art]}</a>
    ))}
  </nav>

  <ul class="artikel-liste">
    {eintraege.map((eintrag) => <GeschaeftListItem eintrag={eintrag} />)}
  </ul>
</BaseLayout>
