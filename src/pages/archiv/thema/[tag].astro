---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GeschaeftListItem from "../../../components/GeschaeftListItem.astro";
import { getDistinctTags, getGeschaefteByTag } from "../../../lib/index-db";
import { archivBeschreibung, slugify } from "../../../lib/format";
import { sammlungJsonLd } from "../../../lib/jsonld";

export function getStaticPaths() {
  return getDistinctTags().map((tag) => ({
    params: { tag: slugify(tag) },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const eintraege = getGeschaefteByTag(tag);
const pfad = `/archiv/thema/${slugify(tag)}/`;
const titel = `${tag}: Geschäfte der Stadt Aarau`;
const beschreibung = archivBeschreibung(eintraege, `zum Thema ${tag}`);
---

<BaseLayout
  title={titel}
  description={beschreibung}
  breadcrumbs={[
    { name: "Startseite", pfad: "/" },
    { name: "Archiv", pfad: "/archiv/" },
    { name: tag, pfad },
  ]}
  jsonLd={[sammlungJsonLd(titel, beschreibung, pfad)]}
>
  <h1>Thema: {tag}</h1>

  <ul class="artikel-liste">
    {eintraege.map((eintrag) => <GeschaeftListItem eintrag={eintrag} />)}
  </ul>
</BaseLayout>
