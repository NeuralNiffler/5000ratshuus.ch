---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import GeschaeftListItem from "../../../../components/GeschaeftListItem.astro";
import {
  getDistinctJahre,
  getDistinctMonateFuerJahr,
  getGeschaefteByJahrMonat,
} from "../../../../lib/index-db";
import { archivBeschreibung, formatMonatJahr } from "../../../../lib/format";
import { sammlungJsonLd } from "../../../../lib/jsonld";

export function getStaticPaths() {
  return getDistinctJahre().flatMap((jahr) =>
    getDistinctMonateFuerJahr(jahr).map((monat) => ({
      params: { jahr, monat },
      props: { jahr, monat },
    })),
  );
}

const { jahr, monat } = Astro.props as { jahr: string; monat: string };
const label = formatMonatJahr(monat, jahr);
const eintraege = getGeschaefteByJahrMonat(jahr, monat);
const pfad = `/archiv/datum/${jahr}/${monat}/`;
const titel = `Aarauer Kommunalpolitik ${label}`;
const beschreibung = archivBeschreibung(eintraege, `aus ${label}`);
---

<BaseLayout
  title={titel}
  description={beschreibung}
  breadcrumbs={[
    { name: "Startseite", pfad: "/" },
    { name: "Archiv", pfad: "/archiv/" },
    { name: jahr, pfad: `/archiv/datum/${jahr}/` },
    { name: label, pfad },
  ]}
  jsonLd={[sammlungJsonLd(titel, beschreibung, pfad)]}
>
  <h1>Archiv {label}</h1>

  <ul class="artikel-liste">
    {eintraege.map((eintrag) => <GeschaeftListItem eintrag={eintrag} />)}
  </ul>
</BaseLayout>
