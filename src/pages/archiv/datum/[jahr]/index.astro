---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import GeschaeftListItem from "../../../../components/GeschaeftListItem.astro";
import {
  getDistinctJahre,
  getDistinctMonateFuerJahr,
  getGeschaefteByJahr,
} from "../../../../lib/index-db";
import { archivBeschreibung, formatMonatJahr } from "../../../../lib/format";
import { sammlungJsonLd } from "../../../../lib/jsonld";

export function getStaticPaths() {
  return getDistinctJahre().map((jahr) => ({
    params: { jahr },
    props: { jahr },
  }));
}

const { jahr } = Astro.props as { jahr: string };
const monate = getDistinctMonateFuerJahr(jahr);
const eintraege = getGeschaefteByJahr(jahr);
const pfad = `/archiv/datum/${jahr}/`;
const titel = `Aarauer Kommunalpolitik ${jahr}`;
const beschreibung = archivBeschreibung(eintraege, `aus dem Jahr ${jahr}`);
---

<BaseLayout
  title={titel}
  description={beschreibung}
  breadcrumbs={[
    { name: "Startseite", pfad: "/" },
    { name: "Archiv", pfad: "/archiv/" },
    { name: jahr, pfad },
  ]}
  jsonLd={[sammlungJsonLd(titel, beschreibung, pfad)]}
>
  <h1>Archiv {jahr}</h1>

  <div class="filter-box">
    <p class="eyebrow">Monate</p>
    <nav class="archiv-nav" aria-label="Nach Monat">
      {monate.map((monat) => (
        <a href={`/archiv/datum/${jahr}/${monat}/`}>{formatMonatJahr(monat, jahr)}</a>
      ))}
    </nav>
  </div>

  <ul class="artikel-liste">
    {eintraege.map((eintrag) => <GeschaeftListItem eintrag={eintrag} />)}
  </ul>
</BaseLayout>
