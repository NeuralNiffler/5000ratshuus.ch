---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import GeschaeftListItem from "../../../components/GeschaeftListItem.astro";
import { getDistinctArten, getGeschaefteByArt, GESCHAEFT_ART_LABEL } from "../../../lib/index-db";
import { archivBeschreibung } from "../../../lib/format";
import { sammlungJsonLd } from "../../../lib/jsonld";
import type { GeschaeftArt } from "../../../lib/schema";

export function getStaticPaths() {
  return getDistinctArten().map((art) => ({
    params: { art },
    props: { art },
  }));
}

const { art } = Astro.props as { art: GeschaeftArt };
const label = GESCHAEFT_ART_LABEL[art];
const eintraege = getGeschaefteByArt(art);
const pfad = `/archiv/art/${art}/`;
const titel = `${label}: Geschäfte der Stadt Aarau`;
const beschreibung = archivBeschreibung(eintraege, `der Art ${label}`);
---

<BaseLayout
  title={titel}
  description={beschreibung}
  breadcrumbs={[
    { name: "Startseite", pfad: "/" },
    { name: "Archiv", pfad: "/archiv/" },
    { name: label, pfad },
  ]}
  jsonLd={[sammlungJsonLd(titel, beschreibung, pfad)]}
>
  <h1>Art des Geschäfts: {label}</h1>

  <ul class="artikel-liste">
    {eintraege.map((eintrag) => <GeschaeftListItem eintrag={eintrag} />)}
  </ul>
</BaseLayout>
