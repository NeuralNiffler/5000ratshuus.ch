---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import ArtikelA from "../../../../components/ArtikelA.astro";
import ArtikelB from "../../../../components/ArtikelB.astro";
import { getAllAusgaben, getArtikelPfad, getOgBildUrl } from "../../../../lib/content";
import { artikelBrotkrumen, artikelJsonLd } from "../../../../lib/jsonld";

export function getStaticPaths() {
  return getAllAusgaben().map((ausgabe) => {
    const { jahr, monat, slug } = getArtikelPfad(ausgabe);
    return { params: { jahr, monat, slug }, props: { ausgabe } };
  });
}

const { ausgabe } = Astro.props;
const { frontmatter } = ausgabe;
---

<BaseLayout
  title={frontmatter.headline}
  description={frontmatter.description}
  keywords={frontmatter.keywords}
  ogDescription={frontmatter.ogDescription}
  ogType="article"
  publishedTime={frontmatter.datePublished}
  modifiedTime={ausgabe.dateModified}
  section={frontmatter.kategorie}
  image={getOgBildUrl(ausgabe)}
  breadcrumbs={artikelBrotkrumen(ausgabe)}
  jsonLd={[artikelJsonLd(ausgabe)]}
>
  {frontmatter.template === "A" ? <ArtikelA ausgabe={ausgabe} /> : <ArtikelB ausgabe={ausgabe} />}
</BaseLayout>
