---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../site.config";
---

<BaseLayout
  title="Kontakt"
  description={`Fehler melden oder Feedback geben zu ${siteConfig.name}.`}
>
  <h1>Kontakt</h1>
  <div class="page-content">
    <p>
      Ist ein Artikel fehlerhaft, eine Quelle nicht mehr erreichbar, oder hast du sonst eine Rückmeldung?
      Über dieses Formular erreichst du uns direkt.
    </p>

    <form class="kontakt-form" method="post" action="/api/kontakt">
      <p>
        <label for="name">Name (optional)</label><br />
        <input type="text" id="name" name="name" autocomplete="name" />
      </p>
      <p>
        <label for="email">E-Mail-Adresse *</label><br />
        <input type="email" id="email" name="email" autocomplete="email" required />
      </p>
      <p>
        <label for="nachricht">Nachricht *</label><br />
        <textarea id="nachricht" name="nachricht" rows="6" required></textarea>
      </p>
      <!--
        Honeypot-Feld gegen einfache Bots (siehe Plan, Frage C5): Für
        Menschen unsichtbar, aber im DOM und für simple Formular-Bots
        ausfüllbar. Der Kontakt-Worker verwirft jede Anfrage, bei der dieses
        Feld nicht leer ist. Absichtlich kein type="hidden" oder
        display:none, weil manche Bots das erkennen und überspringen.
      -->
      <p class="hp-field" aria-hidden="true">
        <label for="website">Website</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
      </p>
      <!--
        Cloudflare Turnstile: prüft im Hintergrund, ob ein Mensch das Formular
        abschickt, und legt das Ergebnis als Token ins Feld
        cf-turnstile-response. Der Kontakt-Worker prüft das Token bei
        Cloudflare nach. Siehe docs/entscheide/2026-09-28-kontaktformular-spamschutz.md.
      -->
      <div class="cf-turnstile" data-sitekey={siteConfig.turnstileSiteKey} data-language="de"></div>
      <noscript>
        <p class="hinweis">
          Zum Schutz vor Spam braucht das Formular JavaScript (Cloudflare Turnstile). Bitte aktiviere JavaScript,
          um eine Nachricht zu senden.
        </p>
      </noscript>
      <p>
        <button type="submit">Nachricht senden</button>
      </p>
    </form>
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </div>
</BaseLayout>

<style>
  .kontakt-form label {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--sub);
  }
  .kontakt-form input,
  .kontakt-form textarea {
    width: 100%;
    max-width: 32rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 0.4rem;
    background: var(--panel);
    color: var(--ink);
  }
  .kontakt-form button {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.55rem 1.1rem;
    border: none;
    border-radius: 0.4rem;
    background: var(--accent);
    color: var(--accent-ink);
    cursor: pointer;
  }
  .kontakt-form button:hover {
    filter: brightness(1.08);
  }
  .cf-turnstile {
    margin: 0.5rem 0 1rem;
  }
  .hinweis {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--sub);
  }
  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
